# GEMINI_API_KEY: Required for server-side Gemini AI API calls (/api/ai/*).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server-configurable Gemini model selection:
# WEBSITE_GENERATOR_MODEL defaults to "gemini-4-argon" (Argon model for Website Generator).
# WEBSITE_FALLBACK_MODEL defaults to "gemini-4-hydrogen" (Hydrogen fallback if Argon is unavailable).
WEBSITE_GENERATOR_MODEL="gemini-4-argon"
WEBSITE_FALLBACK_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# OTP_HMAC_SECRET: Server-side secret used to sign and verify 6-digit Email OTP verification tokens.
# If unset in development, an ephemeral per-process cryptographic key is generated automatically.
OTP_HMAC_SECRET=""

# RESEND_API_KEY: Primary transactional email provider API key for direct 6-digit OTP email delivery.
# RESEND_API_KEY alone is sufficient; SMTP_WEBHOOK_URL is not required when RESEND_API_KEY is set.
RESEND_API_KEY=""
OTP_EMAIL_FROM="AI Engineering Workspace <noreply@yourdomain.com>"

# SMTP_WEBHOOK_URL (Optional): Alternative HTTP webhook endpoint used only when explicitly
# configured and RESEND_API_KEY is unavailable.
SMTP_WEBHOOK_URL=""

# Development-only OTP helper flags (MUST stay "false" / unset in production).
# Production requires real OTP delivery via RESEND_API_KEY and never exposes OTP codes.
ALLOW_SANDBOX_OTP="false"
VITE_ENABLE_DEV_OTP_HELPER="false"
